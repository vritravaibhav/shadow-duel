rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // The Dark section is paid: an entitlement doc is written server-side
    // (purchase backend or tool/grant_dark.sh), never by the client.
    function entitled() {
      return signedIn()
        && exists(/databases/$(database)/documents/entitlements/$(me()))
        && get(/databases/$(database)/documents/entitlements/$(me())).data.dark == true;
    }

    match /entitlements/{uid} {
      allow read: if signedIn() && uid == me();
      allow write: if false;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'char', 'updatedAt']);
    }

    // WebRTC signaling rooms. Only entitled players may host or join; the
    // host owns the offer, the guest the answer, each their own candidates.
    match /rooms/{code} {
      allow read: if entitled();
      allow create: if entitled() && request.resource.data.hostUid == me();
      allow update: if entitled() && (
        resource.data.hostUid == me() ||
        // A guest may claim an empty seat and post the answer.
        (resource.data.guestUid == null && request.resource.data.guestUid == me()) ||
        resource.data.guestUid == me()
      );
      allow delete: if entitled() && resource.data.hostUid == me();

      match /callerCandidates/{id} {
        allow read: if entitled();
        allow create: if entitled() && get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == me();
      }
      match /calleeCandidates/{id} {
        allow read: if entitled();
        allow create: if entitled() && get(/databases/$(database)/documents/rooms/$(code)).data.guestUid == me();
      }
    }
  }
}
